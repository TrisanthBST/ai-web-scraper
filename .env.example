# Copy this file to `.env.local` and fill in your key.
#   cp .env.example .env.local
#
# `.env.local` is git-ignored and must never be committed.

# Required. Create a free key at https://aistudio.google.com/apikey
# Free-tier models are "Free of charge" — no billing needed.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash.
# Any free-tier Gemini text model works, e.g. gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.8-flash
